{
  "name": "chrono",
  "description": "Finish times and watch time for YouTube at your playback speed.",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "package": "npm run zip && npm run zip:firefox && web-ext lint -s .output/firefox-mv3",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare",
    "trim-page": "node scripts/trim-youtube-page.ts"
  },
  "devDependencies": {
    "@fontsource-variable/sora": "^5.3.0",
    "@testing-library/dom": "^10.4.2",
    "@types/node": "^24.19.2",
    "happy-dom": "^21.0.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.4"
  }
}
